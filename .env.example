# ── Frontend (Vite) ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional. If Supabase vars are omitted, the app runs in Demo Mode with
# local sample media and a local demo patron.
#
# Two-tier Patreon mapping. These MUST be the real tier IDs from Patreon, not
# displayed prices or payment amounts. Basic Access is $5; Full Access is $9.50.
# Comma-separate each value if more than one tier maps to the same level.
VITE_PATREON_BASIC_TIER_ID=
VITE_PATREON_FULL_TIER_ID=
# Legacy single-tier fallback. Only used when neither tier above is configured;
# active members mapped through it receive Full Access for backwards compatibility.
VITE_PATREON_TIER_ID=
VITE_PATREON_PAGE_URL=https://www.patreon.com/YOUR_CAMPAIGN
# Cosmetic only: shows the admin link for these emails. Real admin rights come
# from public.profiles.is_admin in the database.
VITE_ADMIN_EMAILS=

# ── Supabase Edge Function secrets ──────────────────────────────
# Set these with: supabase secrets set KEY=value
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase Edge runtime. Never expose the service role key
# to Vite or commit it to git.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CAMPAIGN_ID=
# Two-tier mapping (server-side source of truth).
PATREON_BASIC_TIER_ID=
PATREON_FULL_TIER_ID=
# Legacy fallback, used only when both tier IDs above are empty.
PATREON_TIER_ID=
PATREON_REQUIRED_AMOUNT_CENTS=500
# OAuth redirect URIs. Register every URI you use in the Patreon developer app.
# `PATREON_REDIRECT_URI` is used by the login flow and, when it points at
# `patreon-callback`, by the account-connection flow too.
# `PATREON_CONNECT_REDIRECT_URI` is optional and lets the flows use different
# callbacks. If your Patreon app only allows one redirect URI, point both at
# `https://YOUR_PROJECT.supabase.co/functions/v1/patreon-callback`.
PATREON_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/patreon-callback
PATREON_CONNECT_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/patreon-callback
# Optional legacy login callback if you previously registered this exact URI:
# PATREON_LOGIN_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/patreon-oauth?action=callback
PATREON_STATE_SECRET=generate-a-long-random-string-at-least-32-characters
PATREON_WEBHOOK_SECRET=
# The public origin of the deployed frontend. Used to validate OAuth return
# URLs, restrict CORS, and send users back after a failed login.
APP_URL=https://jerryhub.store
# Optional extra browser origins allowed to call the Edge Functions. APP_URL and
# its www twin are always allowed. Local Vite ports are allowed for development.
ALLOWED_ORIGINS=https://www.jerryhub.store
